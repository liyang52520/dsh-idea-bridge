{
  "name": "@local/dsh-idea-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IDEA → DSH composer bridge: exposes an inbox of message files as local routes and injects them into the active conversation draft.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
